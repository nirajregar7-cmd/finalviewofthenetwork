{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-network-api-gateway",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "RENDER_API_ORIGIN": "https://the-network-api.onrender.com"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "b7c0271e9c584146899181fe94e4de8b"
    }
  ]
}
